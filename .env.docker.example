# RIG OS Agency — Docker environment
# Copy to .env.docker and fill in your keys

# App
NODE_ENV=production
PORT=3737

# Database (uses docker-compose postgres)
DATABASE_URL=postgresql://rigos:rigos@postgres:5432/rigos

# Redis (uses docker-compose redis)
REDIS_URL=redis://redis:6379

# Agent providers
OPENROUTER_API_KEY=
OLLAMA_API_KEY=

# GitHub
GITHUB_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Telegram bot for notifications
TELEGRAM_BOT_TOKEN=

# Optional: Postiz for social scheduling
POSTIZ_API_KEY=

# Optional: Consensus MCP
CONSENSUS_MCP_TOKEN=